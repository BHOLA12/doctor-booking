// Doctor Booking Platform - Database Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  PATHOLOGIST
  PHARMACY
  ADMIN
}

enum ConsultationType {
  ONLINE
  OFFLINE
  BOTH
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  EMERGENCY
  FOLLOW_UP
  NORMAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum MedicineOrderStatus {
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String?
  password   String
  role       Role     @default(PATIENT)
  avatar     String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor             Doctor?
  pharmacy           Pharmacy?
  sessions           Session[]
  auditLogs          AuditLog[]
  verificationRequests VerificationRequest[]
  appointments       Appointment[] @relation("PatientAppointments")
  medicalReports     MedicalReport[]
  prescriptions       Prescription[] @relation("PatientPrescriptions")
  notifications      Notification[]
  reviews            Review[]
  medicineOrders     MedicineOrder[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime? @updatedAt
  isValid          Boolean  @default(true)
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model VerificationRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerType String
  providerId  String
  status      String   @default("PENDING")
  documents   Json?
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Doctor {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   String
  experience       Int
  licenseNumber    String?  @unique
  fees             Int
  bio              String?
  clinicName       String?
  clinicAddress    String?
  city             String   @default("")
  state            String   @default("")
  country          String   @default("")
  latitude         Float?
  longitude        Float?
  hospitalId       String?
  hospital         Hospital? @relation(fields: [hospitalId], references: [id])
  isApproved       Boolean  @default(false)
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  consultationType ConsultationType @default(BOTH)
  degree           String?
  college          String?
  experienceHospitals String?
  currentHospitalName String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots        Slot[]
  appointments Appointment[]
  prescriptions Prescription[] @relation("DoctorPrescriptions")
  reviews      Review[]

  // ── Indexes for fast search + sort (list API) ──
  @@index([isApproved, specialization])                          // filter by spec
  @@index([isApproved, city])                                    // filter by city
  @@index([isApproved, rating(sort: Desc)])                      // sort: top rated
  @@index([isApproved, experience(sort: Desc)])                  // sort: most experienced
  @@index([isApproved, fees])                                    // sort: fees asc/desc
  @@index([isApproved, experience(sort: Desc), totalReviews(sort: Desc), rating(sort: Desc)]) // default sort
  @@index([isApproved, specialization, city])                    // spec + city combined filter
}

model Slot {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sunday, 6=Saturday
  startTime String // "09:00"
  endTime   String // "09:30"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([doctorId, dayOfWeek, startTime])
}

model Appointment {
  id               String   @id @default(cuid())
  patientId        String
  patient          User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date             String // "2024-03-15"
  startTime        String // "09:00"
  endTime          String // "09:30"
  status           AppointmentStatus @default(PENDING)
  consultationType ConsultationType
  appointmentType  AppointmentType    @default(NORMAL)
  priorityRank     Int      @default(3)
  queuePositionSnapshot Int?
  estimatedWaitMinutes Int?
  notes            String?
  symptoms         String?
  isEmergency      Boolean  @default(false)
  paymentStatus    PaymentStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  prescription     Prescription?

  @@index([doctorId, date, status])
  @@index([doctorId, date, priorityRank, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([patientId, doctorId])
}

model MedicalReport {
  id         String   @id @default(cuid())
  patientId  String
  patient    User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  type       String
  date       DateTime
  uploadedAt DateTime @default(now())
  summary    String?

  @@index([patientId, date(sort: Desc)])
}

model Prescription {
  id           String      @id @default(cuid())
  appointmentId String?    @unique
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId    String
  patient      User        @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor      @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  symptoms     String
  diagnosis    String
  medicines    Json
  precautions  String?
  pdfUrl       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([patientId, createdAt(sort: Desc)])
  @@index([doctorId, createdAt(sort: Desc)])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String
  isRead      Boolean  @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Hospital {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  rating      Float    @default(0)
  totalReviews Int     @default(0)
  image       String?
  specialties Json?    // Array of specialties available at the hospital
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors     Doctor[]
}

model Pharmacy {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName       String
  ownerName       String
  pharmacistName  String
  pharmacistRegNo String
  dl20            String
  dl21            String
  gstin           String
  address         String
  pincode         String
  latitude        Float?
  longitude       Float?
  isApproved      Boolean  @default(false)
  rating          Float    @default(4.5)
  totalReviews    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          MedicineOrder[]
}

model MedicineOrder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId  String?
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  items       Json     // Array of { medicineId, name, price, quantity, imageEmoji }
  totalAmount Int
  status      MedicineOrderStatus @default(CONFIRMED)
  address     String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([pharmacyId, createdAt(sort: Desc)])
}
